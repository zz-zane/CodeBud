            {
              "op": "focus",
              "ids": [
                "pt1"
              ]
            },
            {
              "op": "print",
              "text": "pg: 0x3900"
            }
          ]
        }
      ]
    },
    {
      "kind": "pitfall",
      "title": "外部碎片",
      "steps": [
