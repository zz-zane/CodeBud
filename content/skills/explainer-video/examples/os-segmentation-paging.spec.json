          "do": [
            {
              "op": "enter",
              "id": "g-mp",
              "kind": "group",
              "title": "分页的内存",
              "layout": "row"
            },
            {
              "op": "enter",
              "id": "mp1",
              "kind": "box",
              "skin": "memory",
              "group": "g-mp",
              "tag": "框2",
              "value": "空 4KB"
            },
            {
              "op": "enter",
              "id": "mp2",
              "kind": "box",
              "skin": "memory",
              "group": "g-mp",
              "tag": "框6",
              "value": "空 4KB"
            },
            {
              "op": "set",
              "id": "mp1",
              "value": "新页放这"
            }
          ]
        }
      ]
    },
    {
      "kind": "recap",
      "title": "一张表看清差别",
