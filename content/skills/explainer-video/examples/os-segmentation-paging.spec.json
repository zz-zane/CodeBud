        {
          "caption": "四个维度，看清两者的差别",
          "hold": 6,
          "do": [
            {
              "op": "row",
              "cells": [
                "按什么切",
                "程序的逻辑单位",
                "固定大小 4KB"
              ]
            },
            {
              "op": "row",
              "cells": [
                "块的大小",
                "各不相同",
                "全都一样"
              ]
            },
            {
              "op": "row",
              "cells": [
                "越界检查",
                "偏移要小于段长",
                "偏移总在页内"
              ]
            },
            {
              "op": "row",
              "cells": [
                "碎片",
                "外部碎片",
                "只有页内碎片"
              ]
            }
          ]
        },
        {
          "caption": "分段看逻辑，分页看大小",
          "do": [
            {
              "op": "title",
              "text": "分段按逻辑切，分页按大小切"
            }
          ]
        }
      ]
    }
  ],
  "recapHeads": [
