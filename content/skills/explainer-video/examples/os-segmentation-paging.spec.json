              "id": "g-ms",
              "kind": "group",
              "title": "分段的内存",
              "layout": "row"
            },
            {
              "op": "enter",
              "id": "ms1",
              "kind": "box",
              "skin": "memory",
              "group": "g-ms",
              "tag": "空隙",
              "value": "0x300"
            },
            {
              "op": "enter",
              "id": "ms2",
              "kind": "box",
              "skin": "memory",
              "group": "g-ms",
              "tag": "段A",
              "value": "已占用"
            },
            {
              "op": "enter",
              "id": "ms3",
