          "struct Node {",
          "    int val;",
          "    struct Node *next;",
          "};",
          "int main(void) {",
          "    struct Node n1={10}, n3={30};",
          "    struct Node n2 = {20, NULL};",
          "    n1.next = &n3;",
          "    n2.next = n1.next;",
          "    n1.next = &n2;",
          "    printf(\"%d %d %d\\n\",",
          "      n1.val,n1.next->val,",
          "      n1.next->next->val);",
          "    return 0;",
          "}"
