      "title": "换成真正的代码",
      "skin": "memory",
      "code": {
        "lang": "java",
        "lines": [
          "class Box {",
          "    int v;",
          "    Box(int v) { this.v = v; }",
          "}",
          "public class Main {",
          "    static void change(Box b) {",
          "        b.v = 99;",
          "        b = new Box(1);",
          "    }",
          "    public static void main(String[] args) {",
          "        Box box = new Box(5);",
          "        change(box);",
          "        System.out.println(box.v);",
          "    }",
          "}"
        ],
        "expectedOutput": "99\n"
      },
