    {
      "title": "换成真正的代码",
      "skin": "memory",
      "code": {
        "lang": "c",
        "lines": [
          "#include <stdio.h>",
          "void bad_swap(int x, int y) {",
          "    int t = x; x = y; y = t;",
          "}",
          "void real_swap(int *x, int *y) {",
          "    int t = *x; *x = *y; *y = t;",
          "}",
          "int main(void) {",
          "    int a = 3, b = 8;",
          "    bad_swap(a, b);",
          "    printf(\"%d %d\\n\", a, b);",
          "    real_swap(&a, &b);",
          "    printf(\"%d %d\\n\", a, b);",
          "    return 0;",
          "}"
        ],
        "expectedOutput": "3 8\n8 3\n"
      },
