          "#include <stdio.h>",
          "int main(void) {",
          "    int a = 5;",
          "    int *p = &a;",
          "    printf(\"%d\\n\", *p);",
          "    *p = 9;",
          "    printf(\"%d\\n\", a);",
          "    return 0;",
          "}"
        ],
        "expectedOutput": "5\n9\n"
      },
